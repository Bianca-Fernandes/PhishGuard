# Copy this file to ".env" and fill in your own values.
# Never upload your real .env file to GitHub.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=phishguard

# Machine learning service
ML_SERVICE_URL=http://127.0.0.1:5001
# MODEL_VERSION=v1        # leave empty to load the newest model

# Threat intelligence (optional)
# Free key: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=
ENABLE_OPENPHISH=true

# Domain intelligence (RDAP, DNS, TLS). Set to false to work offline.
ENABLE_DOMAIN_INTEL=true
NETWORK_TIMEOUT=5

# Set to true only when the site runs on HTTPS
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
